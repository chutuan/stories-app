{
  // eas.json chấp nhận comment (EAS CLI parse JSON5 khi JSON thường lỗi).
  "cli": {
    "version": ">= 16.0.0",
    // "remote": EAS giữ ios.buildNumber / android.versionCode trên server và
    // tự tăng. Nhờ vậy app.config.js không cần khai hai giá trị đó.
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      // Build dev client để chạy `npx expo start --dev-client` với native module
      // (AdMob không chạy được trong Expo Go).
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        // Máy thật/simulator gọi backend chạy trên máy dev.
        // Android emulator: đổi thành http://10.0.2.2:8001/api
        // Thiết bị thật: đổi thành http://<IP-LAN-máy-dev>:8001/api
        "EXPO_PUBLIC_API_URL": "http://localhost:8001/api"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      // Bản test nội bộ: cài tay bằng file APK, không cần Play Store.
      "distribution": "internal",
      "env": {
        // THAY bằng domain staging thật (bắt buộc https:// nếu test trên iOS).
        "EXPO_PUBLIC_API_URL": "https://api.tunastory.com/api"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "simulator": {
      // Bản native chạy trên MÁY ẢO iOS, dùng để chụp ảnh App Store sạch:
      // là app thật nên KHÔNG có nút dev của Expo Go như khi chạy qua Expo Go.
      // Không đặt developmentClient -> bundle production, không có overlay dev.
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.tunastory.com/api"
      }
    },
    "production": {
      // Bản phát hành: TestFlight (iOS) + Play Internal Testing (Android).
      // autoIncrement: EAS tự tăng ios.buildNumber và android.versionCode
      // sau mỗi lần build, tránh bị store từ chối vì trùng số build.
      "autoIncrement": true,
      "android": {
        // .aab là định dạng bắt buộc để upload lên Google Play.
        "buildType": "app-bundle"
      },
      "env": {
        // Domain API production. Đổi tại đây nếu sau này tách staging riêng.
        // BẮT BUỘC https:// — iOS App Transport Security chặn HTTP thường.
        "EXPO_PUBLIC_API_URL": "https://api.tunastory.com/api",

        // --- AdMob ---
        // KHÔNG phải bí mật: mọi ID này nằm sẵn trong binary đã phát hành và trong
        // app-ads.txt công khai, nên commit vào kho là bình thường.
        //
        // THIẾU khoá nào thì src/lib/ads.tsx im lặng rơi về ID TEST của Google, và
        // bản phát hành sẽ hiện banner dán nhãn "Test Ad" — đúng lỗi của build
        // 1.0.0 (2) đang bị Apple xét. EAS không cho để giá trị rỗng, nên khoá nào
        // chưa có ID thật thì BỎ HẲN dòng đó chứ đừng để "".
        //
        // LƯU Ý: iOS và Android là HAI APP RIÊNG trong AdMob -> App ID lẫn unit ID
        // đều khác nhau, unit ID của bên này KHÔNG chạy cho bên kia.
        "EXPO_PUBLIC_ADMOB_IOS_APP_ID": "ca-app-pub-9892355907152840~9913447750",
        "EXPO_PUBLIC_ADMOB_BANNER_ID_IOS": "ca-app-pub-9892355907152840/3899537894",
        "EXPO_PUBLIC_ADMOB_REWARDED_ID_IOS": "ca-app-pub-9892355907152840/3713659468"

        // CÒN THIẾU — chỉ cần khi phát hành Android (iOS đã đủ):
        //   "EXPO_PUBLIC_ADMOB_ANDROID_APP_ID":      "ca-app-pub-XXXX~XXXX"
        //   "EXPO_PUBLIC_ADMOB_BANNER_ID_ANDROID":   "ca-app-pub-XXXX/XXXX"
        //   "EXPO_PUBLIC_ADMOB_REWARDED_ID_ANDROID": "ca-app-pub-XXXX/XXXX"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        // Apple ID của APP RECORD trong App Store Connect (mục App Information),
        // KHÔNG phải Apple ID tài khoản developer.
        "ascAppId": "6810302346"
      },
      "android": {
        // TODO: đặt đường dẫn service account key của Google Play, ví dụ:
        // "serviceAccountKeyPath": "./google-play-service-account.json"
        // (file này KHÔNG được commit — đã nằm trong .gitignore)
        "track": "internal"
      }
    }
  }
}
