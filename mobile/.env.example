# ==========================================================================
# Biến môi trường cho app mobile (Expo SDK 57).
#
# CÁCH DÙNG:
#   cp .env.example .env      # rồi sửa giá trị trong .env
#
# LƯU Ý QUAN TRỌNG:
# - Tiền tố EXPO_PUBLIC_ nghĩa là giá trị được NHÚNG THẲNG vào bundle JS và
#   AI CŨNG ĐỌC ĐƯỢC sau khi giải nén app. TUYỆT ĐỐI không đặt secret
#   (API key riêng, mật khẩu, token) vào đây.
# - File .env KHÔNG được commit (đã có trong .gitignore). Chỉ commit file
#   .env.example này.
# - Khi build bằng EAS, biến được lấy từ mục "env" của profile trong eas.json,
#   KHÔNG phải từ file .env này.
# ==========================================================================

# --- API backend ------------------------------------------------------------
# URL gốc của REST API Laravel, có hậu tố /api.
#   Simulator iOS / web:        http://localhost:8001/api
#   Emulator Android:           http://10.0.2.2:8001/api   (10.0.2.2 = localhost của máy host)
#   Thiết bị thật cùng Wi-Fi:   http://192.168.1.10:8001/api  (thay bằng IP LAN máy dev)
#   Production:                 https://api.tenmien-that.com/api
# BẮT BUỘC dùng https:// cho production — iOS chặn HTTP thường (App Transport Security).
EXPO_PUBLIC_API_URL=http://localhost:8001/api

# --- AdMob: App ID (dạng ca-app-pub-XXXX~YYYY, dấu ngã ~) --------------------
# Lấy trong AdMob Console > Apps > App settings > App ID.
# Bỏ trống thì app.config.js tự dùng App ID TEST của Google (KHÔNG ra doanh thu).
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=

# --- AdMob: Ad unit ID (dạng ca-app-pub-XXXX/ZZZZ, dấu gạch chéo /) ----------
# Lấy trong AdMob Console > Ad units. Mỗi nền tảng thường có unit ID riêng;
# nếu cần tách iOS/Android thì build hai profile EAS với giá trị khác nhau.
# Bỏ trống thì src/lib/ads.tsx tự dùng unit ID TEST của Google.
#   Banner   — hiển thị ở đầu màn hình đọc truyện.
#   Rewarded — quảng cáo có thưởng, xem xong cộng xu cho người dùng.
EXPO_PUBLIC_ADMOB_BANNER_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ID=

# --- EAS --------------------------------------------------------------------
# ID project trên Expo. Chạy `eas init` một lần để tạo; EAS CLI sẽ in ra ID.
# Vì dùng dynamic config (app.config.js) nên phải tự dán ID vào đây
# hoặc trực tiếp vào extra.eas.projectId trong app.config.js.
EAS_PROJECT_ID=

# --- AdMob (để trống -> tự dùng ID TEST của Google, KHÔNG ra doanh thu) ---
# iOS và Android là hai app riêng trong AdMob: App ID và unit ID đều khác nhau.
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_ID_IOS=
EXPO_PUBLIC_ADMOB_BANNER_ID_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_ID_IOS=
EXPO_PUBLIC_ADMOB_REWARDED_ID_ANDROID=
