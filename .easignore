# EAS đóng gói cả repo để build. Những thứ dưới đây không cần cho việc build,
# loại ra để mỗi lần upload không phải gửi thừa hàng chục MB.

# Ảnh chụp màn hình nộp store (~18MB)
store/screenshots/

# Tài liệu
DEPLOY.md
SPEC.md
store/APP_STORE.md

# Hạ tầng server, không liên quan app mobile
deploy/
backend/

# Thư mục native sinh bởi `expo prebuild`. PHẢI loại ra.
# .easignore ĐƯỢC ƯU TIÊN HƠN .gitignore, nên dù /ios đã bị gitignore thì nếu không
# ghi ở đây nó vẫn được tải lên EAS. Mà EAS thấy thư mục native có sẵn là BỎ QUA
# prebuild — tức mọi thay đổi trong app.config.js (khoá Info.plist, ID AdMob, plugin)
# sẽ không được áp, build ra binary theo cấu hình cũ mà không báo lỗi gì.
mobile/ios/
mobile/android/

# File .env của máy dev. Đã bị .gitignore, NHƯNG .easignore được ưu tiên hơn
# .gitignore nên không ghi ở đây thì nó vẫn được tải lên EAS. Đã kiểm: biến trong
# mục `env` của eas.json vẫn thắng .env, nên đây là phòng xa chứ không phải đang
# lỗi — cái tránh được là một .env có giá trị SAI cho khoá mà eas.json không đặt,
# loại đó sẽ lặng lẽ chui vào bản phát hành.
mobile/.env

# .easignore THAY HẲN .gitignore nên mọi thứ bị gitignore mà không ghi lại ở đây đều
# bị tải lên. Kiểm 09/11/2026 (build Android đầu tiên): imports/ 5,4GB, .claude/ 1,7GB.
/imports/
.claude/
**/node_modules/
store/creative/
hoi-thoai-thanh-tra-banh-mi.txt
.DS_Store
*.log
__pycache__/
mobile/.env.*
!mobile/.env.example
# google-services.json đi qua biến môi trường kiểu file GOOGLE_SERVICES_JSON trên EAS.
mobile/google-services.json
# Tương tự cho Firebase iOS: GOOGLE_SERVICE_INFO_PLIST.
mobile/GoogleService-Info.plist
*firebase-adminsdk*.json
mobile/google-play-service-account.json
