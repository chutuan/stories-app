# =============================================================================
# MẪU CẤU HÌNH MÔI TRƯỜNG PRODUCTION — backend Laravel "Stories"
# =============================================================================
# QUAN TRỌNG: File này CHỈ LÀ MẪU và KHÔNG chứa bất kỳ secret thật nào.
# Cách dùng trên VPS:
#     cp .env.production.example .env
#     php artisan key:generate          # sinh APP_KEY thật, ghi thẳng vào .env
#     nano .env                          # điền các giá trị còn trống
#     chmod 600 .env                     # chỉ chủ sở hữu đọc được
# File .env thật đã nằm trong .gitignore — TUYỆT ĐỐI không commit nó.
# =============================================================================

# --- Ứng dụng ----------------------------------------------------------------
# Tên ứng dụng, hiển thị ở trang admin và email.
APP_NAME=Stories

# BẮT BUỘC là "production": tắt trang lỗi chi tiết, bật tối ưu của Laravel,
# và kích hoạt chốt an toàn trong AdminUserSeeder (bắt buộc có ADMIN_PASSWORD).
APP_ENV=production

# Khoá mã hoá ứng dụng. ĐỂ TRỐNG rồi chạy: php artisan key:generate
# (lệnh này tự ghi giá trị base64:... vào file .env). Không copy key từ máy khác.
APP_KEY=

# BẮT BUỘC false trên production. Nếu để true, mọi stack trace và biến môi trường
# sẽ lộ ra cho người dùng khi có lỗi.
APP_DEBUG=false

# URL gốc công khai. BẮT BUỘC dùng https:// — iOS chặn HTTP thường (App Transport
# Security) nên app mobile sẽ không gọi được API qua http://.
APP_URL=https://api.tunastory.com

# Ngôn ngữ mặc định.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Lưu ý: múi giờ ứng dụng được cố định 'UTC' trong config/app.php (không đọc env),
# nên không cần khai báo APP_TIMEZONE ở đây.

# Driver lưu cờ bảo trì (php artisan down).
APP_MAINTENANCE_DRIVER=file

# Số vòng băm bcrypt cho mật khẩu. 12 là mức cân bằng an toàn/tốc độ.
BCRYPT_ROUNDS=12

# --- Ghi log ------------------------------------------------------------------
# Trên production nên dùng "daily" để log tự xoay vòng theo ngày, tránh 1 file khổng lồ.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null

# Chỉ ghi từ mức warning trở lên để log không phình to (debug|info|warning|error).
LOG_LEVEL=warning

# Số ngày giữ file log khi dùng channel daily.
LOG_DAILY_DAYS=14

# --- Cơ sở dữ liệu ------------------------------------------------------------
DB_CONNECTION=mysql

# MySQL chạy cùng máy chủ -> để 127.0.0.1 (không mở port 3306 ra Internet).
DB_HOST=127.0.0.1
DB_PORT=3306

# Tên database riêng cho ứng dụng.
DB_DATABASE=stories

# TUYỆT ĐỐI KHÔNG dùng tài khoản root. Tạo user riêng chỉ có quyền trên DB này:
#   CREATE DATABASE stories CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'stories'@'127.0.0.1' IDENTIFIED BY 'MAT_KHAU_MANH_NGAU_NHIEN';
#   GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, DROP, REFERENCES
#     ON stories.* TO 'stories'@'127.0.0.1';
#   FLUSH PRIVILEGES;
DB_USERNAME=stories

# Mật khẩu DB — điền trên máy chủ, KHÔNG ghi vào file mẫu này.
# Sinh mật khẩu: openssl rand -base64 24
DB_PASSWORD=

# --- Session / Cache / Queue --------------------------------------------------
# Admin web dùng session; lưu ở database để không phụ thuộc file tạm.
# (Bảng sessions đã có sẵn trong migration.)
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Mã hoá dữ liệu session lưu trong DB.
SESSION_ENCRYPT=true
SESSION_PATH=/

# Domain của cookie session; để null cho domain hiện tại, hoặc .tunastory.com nếu
# dùng chung nhiều subdomain.
SESSION_DOMAIN=null

# Chỉ gửi cookie qua HTTPS. Bắt buộc bật vì production chạy TLS.
SESSION_SECURE_COOKIE=true

# Chặn JavaScript đọc cookie session.
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cache dùng database (không cần cài Redis). Bảng cache đã có trong migration.
# Rate limit của API cũng dùng store này -> bắt buộc phải chạy migrate.
CACHE_STORE=database

# Hàng đợi dùng database + worker systemd (queue:work). Bảng jobs đã có sẵn.
QUEUE_CONNECTION=database

# Ổ đĩa mặc định. Code upload (ảnh bìa, audio TTS) luôn chỉ định rõ disk 'public'
# nên biến này không ảnh hưởng nghiệp vụ; giữ 'local' giống môi trường dev.
# BẮT BUỘC chạy `php artisan storage:link` để public/storage trỏ tới storage/app/public.
FILESYSTEM_DISK=local

# Kênh broadcast không dùng đến.
BROADCAST_CONNECTION=log

# --- Tài khoản quản trị khởi tạo (AdminUserSeeder) ----------------------------
# Email đăng nhập trang /admin. Nên đổi khác mặc định.
# Email hỗ trợ hiện trên trang / , /privacy và /terms.
# Store BẮT BUỘC có kênh liên hệ thật — phải là hòm thư bạn đọc được.
SUPPORT_EMAIL=support@tunastory.com
# Ngày cập nhật văn bản pháp lý hiển thị trên trang privacy/terms.
LEGAL_UPDATED="9 September 2026"

ADMIN_EMAIL=admin@tunastory.com

# BẮT BUỘC điền khi APP_ENV=production. Nếu để trống, seeder sẽ ném RuntimeException
# và KHÔNG tạo tài khoản mật khẩu yếu.
# Sinh mật khẩu mạnh: openssl rand -base64 24
# Sau khi chạy `php artisan db:seed --class=AdminUserSeeder --force`, nên xoá dòng
# này khỏi .env vì mật khẩu đã được băm và lưu trong DB.
ADMIN_PASSWORD=

# --- OpenAI (giọng đọc AI / TTS) ---------------------------------------------
# Key thật lấy tại https://platform.openai.com — điền trực tiếp trên máy chủ.
# KHÔNG commit key. Nếu để trống, chức năng tạo giọng đọc trong admin sẽ không dùng được.
OPENAI_API_KEY=

# Model TTS sử dụng.
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# --- CORS ---------------------------------------------------------------------
# Danh sách origin được phép gọi API, cách nhau bởi dấu phẩy.
# API /api là API công khai chỉ đọc nên '*' là chấp nhận được.
# Muốn siết lại, ví dụ: CORS_ALLOWED_ORIGINS=https://tunastory.com
# App mobile (native) không bị CORS ràng buộc — mục này chỉ ảnh hưởng trình duyệt web.
CORS_ALLOWED_ORIGINS=*

# --- Giới hạn tần suất API (rate limit) ---------------------------------------
# Số request/phút cho mỗi IP với các endpoint API thông thường.
API_RATE_LIMIT=60

# Số request/phút cho mỗi IP với endpoint đọc nội dung chương (nới rộng hơn
# vì người dùng lật chương liên tục). Đếm bằng "xô" riêng, không dùng chung với trên.
API_RATE_LIMIT_READ=180

# --- Email --------------------------------------------------------------------
# Ứng dụng hiện không gửi email; để "log" cho an toàn. Nếu cần gửi thật thì đổi
# sang smtp và điền MAIL_HOST/MAIL_USERNAME/MAIL_PASSWORD trên máy chủ.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@tunastory.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Vite ---------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
